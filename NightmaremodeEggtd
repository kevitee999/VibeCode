-- ============================================================
-- MATCH START AUTO-QUEUE SCRIPT (Mobile Optimized & Loop Retry)
-- ============================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer

-- 1. Wait for game and character to fully load
if not game:IsLoaded() then
    game.Loaded:Wait()
end

-- Helper function to ensure character & HRP exist on mobile
local function getHRP()
    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart", 15)
end

local hrp = getHRP()

-- 2. Initial wait after loading
task.wait(5)

print("[Match Auto-Queue] Initialized (Mobile Mode). Monitoring workspace.Lobby...")

-- 3. Main Loop (Runs & Re-checks every 15 seconds if Lobby exists)
while true do
    if workspace:FindFirstChild("Lobby") then
        local currentHRP = getHRP()
        
        if currentHRP then
            -- Safe Teleport with Physics Reset (Bypasses Mobile Rubberbanding)
            currentHRP.AssemblyLinearVelocity = Vector3.zero
            currentHRP.AssemblyAngularVelocity = Vector3.zero
            currentHRP.CFrame = CFrame.new(-396, 2, -37)
            
            -- Wait 1 second after CFrame positioning
            task.wait(1)
            
            -- Re-verify Lobby still exists after the wait before firing remote
            if workspace:FindFirstChild("Lobby") then
                pcall(function()
                    local remotes = ReplicatedStorage:WaitForChild("Main", 5):WaitForChild("Remotes", 5)
                    local matchStart = remotes:WaitForChild("MatchStartRequest", 5)
                    
                    local args = {
                        [1] = "Start",
                        n = 1,
                    }
                    matchStart:FireServer(unpack(args, 1, args.n or #args))
                    print("[Match Auto-Queue] Teleported to (-396, 2, -37) and fired MatchStartRequest!")
                end)
            end
        end
        
        -- Wait 15 seconds before checking & re-triggering if still in Lobby
        task.wait(15)
    else
        -- If workspace.Lobby is gone (game started), check back every 2 seconds
        task.wait(5)
    end
end
